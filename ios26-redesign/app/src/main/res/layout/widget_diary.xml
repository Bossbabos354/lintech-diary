<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="26dp">

        <TextView
            android:id="@+id/w_diary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#24272A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/w_row_1"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/w_row1_time"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#757575"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/w_row1_time"
                android:layout_toStartOf="@id/w_row1_chip"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_row1_subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                android:ellipsize="end"
                    android:textColor="#24272A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_row1_hw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                android:ellipsize="end"
                    android:textColor="#5E656B"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/w_row1_chip"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/wg_chip_lav">

                <TextView
                    android:id="@+id/w_row1_mark"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#B39DDB"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/w_sep_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="#F0EDF7" />

        <RelativeLayout
            android:id="@+id/w_row_2"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/w_row2_time"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#757575"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/w_row2_time"
                android:layout_toStartOf="@id/w_row2_chip"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_row2_subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                android:ellipsize="end"
                    android:textColor="#24272A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_row2_hw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                android:ellipsize="end"
                    android:textColor="#5E656B"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/w_row2_chip"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/wg_chip_lav">

                <TextView
                    android:id="@+id/w_row2_mark"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#B39DDB"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/w_sep_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="#F0EDF7" />

        <RelativeLayout
            android:id="@+id/w_row_3"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/w_row3_time"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#757575"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/w_row3_time"
                android:layout_toStartOf="@id/w_row3_chip"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_row3_subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                android:ellipsize="end"
                    android:textColor="#24272A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_row3_hw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                android:ellipsize="end"
                    android:textColor="#5E656B"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/w_row3_chip"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/wg_chip_lav">

                <TextView
                    android:id="@+id/w_row3_mark"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#B39DDB"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/w_diary_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#955DCD"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.8"
        android:includeFontPadding="false"
        android:text="Цифровой помощник"
        android:textColor="#9AA0B5"
        android:textSize="8sp" />
</FrameLayout>
