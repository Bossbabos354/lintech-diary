<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/w_hw_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_hw_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Домашка на сегодня"
                android:textColor="#F3F4FA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_hw_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wg_hw_pill_accent"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="0 / 0"
                android:textColor="#8585FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/w_hw_progress_box"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="8dp">

            <ProgressBar
                android:id="@+id/w_hw_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/wg_hw_bar_dark" />

            <ProgressBar
                android:id="@+id/w_hw_progress_done"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/wg_hw_bar_dark_done"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/w_hw_progress_light"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/wg_hw_bar_light"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/w_hw_progress_light_done"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/wg_hw_bar_light_done"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/w_hw_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/w_hw_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="На сегодня домашки нет"
            android:textColor="#9CA2B2"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
