<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SchoolDiary" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="cardBackground">@drawable/bg_card_outline_light</item>
        <item name="dashedDivider">@drawable/divider_dashed_light</item>
        <item name="android:windowAnimationStyle">@style/GlassWindowAnimation</item>
    </style>

    <style name="Theme.SchoolDiary.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="cardBackground">@drawable/bg_card_outline_light</item>
        <item name="dashedDivider">@drawable/divider_dashed_light</item>
        <item name="android:windowAnimationStyle">@style/GlassWindowAnimation</item>
    </style>

    <style name="Theme.SchoolDiary.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="cardBackground">@drawable/bg_card_outline_dark</item>
        <item name="dashedDivider">@drawable/divider_dashed_dark</item>
        <item name="android:windowAnimationStyle">@style/GlassWindowAnimation</item>
    </style>
    <style name="GlassWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/glass_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/glass_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/glass_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/glass_close_exit</item>
    </style>
</resources>