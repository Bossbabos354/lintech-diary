"<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>ЛинТех 28 — Электронный дневник</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n<!-- Анимация запуска -->\n<div id=\"splash\" class=\"splash\">\n  <div class=\"terminal\" id=\"splashTerminal\"></div>\n  <svg class=\"slogo\" viewBox=\"-120 -140 240 280\" fill=\"none\" stroke=\"#ffffff\"\n       stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n    <rect x=\"-100\" y=\"-130\" width=\"200\" height=\"260\" rx=\"24\"/>\n    <line x1=\"-118\" y1=\"-100\" x2=\"-118\" y2=\"-40\"/>\n    <line x1=\"-74\" y1=\"-80\" x2=\"74\" y2=\"-80\"/>\n    <line x1=\"-74\" y1=\"-42\" x2=\"74\" y2=\"-42\"/>\n    <line x1=\"-74\" y1=\"-4\" x2=\"74\" y2=\"-4\"/>\n    <line x1=\"-74\" y1=\"34\" x2=\"74\" y2=\"34\"/>\n    <path d=\"M-50 84 L-20 114 L24 66\"/>\n  </svg>\n  <div class=\"welcome\">Добро пожаловать</div>\n</div>\n\n<!-- Страница входа -->\n<div id=\"loginScreen\" class=\"login-wrap\">\n  <div class=\"topbar\">\n    <div>\n      <div class=\"brand\">ЛинТех 28</div>\n      <div style=\"opacity:0.85;font-size:15px\">Электронный дневник</div>\n    </div>\n  </div>\n  <div class=\"login-card\">\n    <h2>Вход</h2>\n    <input type=\"text\" id=\"loginField\" placeholder=\"Логин\" autocomplete=\"username\">\n    <input type=\"password\" id=\"passwordField\" placeholder=\"Пароль\" autocomplete=\"current-password\">\n    <button class=\"btn primary\" id=\"loginBtn\">Войти</button>\n    <div id=\"loginError\" class=\"state-msg error hidden\" style=\"padding:12px 0 0\"></div>\n  </div>\n  <div class=\"privacy\">Я не собираю ваши данные и не использую их!<br>Они хранятся только на вашем устройстве!</div>\n</div>\n\n<!-- Главное приложение -->\n<div id=\"appScreen\" class=\"app hidden\">\n  <div class=\"topbar\">\n    <div class=\"brand\">ЛинТех 28 — Дневник</div>\n    <div class=\"actions\">\n      <button id=\"bellIcon\" class=\"bell\" title=\"Уведомления\">🔔<span id=\"bellBadge\" class=\"badge hidden\">0</span></button>\n      <button id=\"searchIcon\" title=\"Поиск\">🔍</button>\n    </div>\n  </div>\n  <div id=\"screens\" class=\"screens\"></div>\n  <nav class=\"navbar\">\n    <button class=\"nav-item\" data-tab=\"dairy\"><span class=\"ico\">📖</span>Дневник</button>\n    <button class=\"nav-item\" data-tab=\"schedule\"><span class=\"ico\">🗓️</span>Расписание</button>\n    <button class=\"nav-item\" data-tab=\"marks\"><span class=\"ico\">⭐</span>Оценки</button>\n    <button class=\"nav-item\" data-tab=\"goals\"><span class=\"ico\">🚩</span>Цели</button>\n    <button class=\"nav-item\" data-tab=\"events\"><span class=\"ico\">📅</span>События</button>\n    <button class=\"nav-item\" data-tab=\"settings\"><span class=\"ico\">⚙️</span>Настройки</button>\n  </nav>\n</div>\n\n<div id=\"overlay\" class=\"overlay hidden\"></div>\n\n<!-- Раскрывающаяся карточка урока -->\n<div id=\"sheetOverlay\" class=\"sheet-overlay hidden\">\n  <div class=\"sheet-wrap\">\n    <div class=\"sheet\" id=\"sheetCard\"></div>\n  </div>\n</div>\n\n<script src=\"app.js?v=7\"></script>\n<script>\n// ---------------- Тема ----------------\nconst THEME_KEY = 'diary_theme';\nfunction applyTheme() {\n  const saved = localStorage.getItem(THEME_KEY) || 'system';\n  if (saved === 'zhan') { document.documentElement.setAttribute('data-theme', 'zhan'); return; }\n  const dark = saved === 'dark' || (saved === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);\n  document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');\n}\napplyTheme();\nwindow.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyTheme);\nconst getTheme = () => localStorage.getItem(THEME_KEY) || 'system';\nconst setTheme = (t) => { localStorage.setItem(THEME_KEY, t); applyTheme(); };\n\n// ---------------- Состояние ----------------\nconst L_KEY = 'diary_login';\nconst P_KEY = 'diary_password';\nconst S_KEY = 'diary_student_id';\nconst Y_KEY = 'diary_uch_year';\nconst U_KEY = 'diary_user_id';\nconst C_KEY = 'diary_class_id';\n\nlet state = { tab: 'dairy' };\n\nconst $ = (id) => document.getElementById(id);\nconst el = (tag, cls, html) => { const e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; };\n\nfunction overlay() { return $('overlay'); }\nfunction showOverlay(child) {\n  const o = overlay();\n  o.innerHTML = '';\n  o.appendChild(child);\n  o.classList.remove('hidden');\n}\nfunction hideOverlay() { overlay().classList.add('hidden'); overlay().innerHTML = ''; }\n\n// ---------------- Хранилище (аналог Prefs) ----------------\nconst Prefs = {\n  login: () => localStorage.getItem(L_KEY) || '',\n  password: () => localStorage.getItem(P_KEY) || '',\n  studentId: () => parseInt(localStorage.getItem(S_KEY), 10) || -1,\n  setStudentId: (id) => localStorage.setItem(S_KEY, String(id)),\n  setUchYear: (y) => localStorage.setItem(Y_KEY, String(y)),\n  uchYear: () => parseInt(localStorage.getItem(Y_KEY), 10) || new Date().getFullYear(),\n  setUserId: (id) => localStorage.setItem(U_KEY, String(id)),\n  userId: () => parseInt(localStorage.getItem(U_KEY), 10) || -1,\n  setClassId: (id) => localStorage.setItem(C_KEY, String(id)),\n  classId: () => parseInt(localStorage.getItem(C_KEY), 10) || -1,\n  saveCredentials: (login, password, sid) => {\n    localStorage.setItem(L_KEY, login);\n    localStorage.setItem(P_KEY, password);\n    localStorage.setItem(S_KEY, String(sid));\n  },\n  clearCredentials: () => {\n    [L_KEY, P_KEY, S_KEY, Y_KEY, U_KEY, C_KEY].forEach(k => localStorage.removeItem(k));\n  },\n};\n\n// ---------------- Экран «Дневник» ----------------\nfunction renderDairy() {\n  const wrap = el('div');\n  const weekbar = el('div', 'weekbar');\n  const prev = el('button', 'btn ghost small', '◀');\n  const label = el('div', 'label', '…');\n  const next = el('button', 'btn ghost small', '▶');\n  weekbar.appendChild(prev); weekbar.appendChild(label); weekbar.appendChild(next);\n  const todayWrap = el('div', 'today-wrap');\n  const todayBtn = el('button', 'btn secondary small', 'Сегодня');\n  todayWrap.appendChild(todayBtn);\n  wrap.appendChild(weekbar); wrap.appendChild(todayWrap);\n\n  let weekOffset = 0;\n  const listCont = el('div');\n  let reqSeq = 0;\n\n  async function load() {\n    const seq = ++reqSeq;\n    listCont.innerHTML = '<div class=\"spinner\"></div>';\n    try {\n      const sid = Prefs.studentId();\n      if (sid === -1) throw new Error('Нет данных об ученике');\n      let cid = Prefs.classId();\n      if (cid === -1) {\n        cid = await Diary.getStudentClass(sid, Prefs.uchYear());\n        Prefs.setClassId(cid);\n      }\n      const { monday, sunday } = Diary.weekRange(weekOffset);\n      const fmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'short' });\n      label.textContent = `${fmt.format(monday)} — ${fmt.format(sunday)}`;\n      const entries = await Diary.getDairy(cid, sid, monday, sunday);\n\n      if (seq !== reqSeq) return; // более новые запросы уже пошли — игнорируем\n\n      if (!entries.length) {\n        listCont.innerHTML = '<div class=\"state-msg\">Нет данных за эту неделю</div>';\n        return;\n      }\n      listCont.innerHTML = '';\n      const groups = groupByDay(entries);\n      groups.forEach(day => listCont.appendChild(renderDay(day)));\n    } catch (e) {\n      if (seq !== reqSeq) return;\n      listCont.innerHTML = `<div class=\"state-msg error\">Ошибка: ${escapeHtml(e.message)}</div>`;\n    }\n  }\n  prev.onclick = () => { weekOffset -= 1; load(); };\n  next.onclick = () => { weekOffset += 1; load(); };\n  todayBtn.onclick = () => { weekOffset = 0; load(); };\n\n  wrap.appendChild(listCont);\n  load();\n  return wrap;\n}\n\nfunction localDayKey(d) {\n  return d.getFullYear() + '-' +\n    String(d.getMonth() + 1).padStart(2, '0') + '-' +\n    String(d.getDate()).padStart(2, '0');\n}\n\nfunction groupByDay(entries) {\n  // Группируем по ЛОКАЛЬНОЙ дате (не UTC): toISOString() сдвигал день на –1\n  // для UTC+3 (локальная полночь = 21:00 предыдущего дня UTC).\n  const map = new Map();\n  for (const e of entries) {\n    const key = localDayKey(e.date);\n    if (!map.has(key)) map.set(key, []);\n    map.get(key).push(e);\n  }\n  const sorted = Array.from(map.entries()).sort((a, b) => a[0].localeCompare(b[0]));\n  return sorted.map(x => x[1]);\n}\n\nconst SUBJ_COLORS = ['#7C4DFF', '#FF4081', '#00BFA6', '#FF9800', '#42A5F5',\n  '#66BB6A', '#AB47BC', '#EF5350', '#26C6DA'];\nconst subjColor = (id) => SUBJ_COLORS[((id % SUBJ_COLORS.length) + SUBJ_COLORS.length) % SUBJ_COLORS.length];\nconst markGlow = (mark) => {\n  const v = parseInt(mark.replace('!', ''), 10);\n  if (v >= 5) return '#66BB6A';\n  if (v === 4) return '#FFD54F';\n  if (v === 3) return '#FF9800';\n  return '#EF5350';\n};\nconst markStat = (mark) => {\n  const raw = mark.replace('!', '');\n  const n = parseInt(raw, 10);\n  if (mark.startsWith('!')) return { n, color: 'var(--mark-bad)' };\n  if (n >= 4) return { n, color: 'var(--mark-excellent)' };\n  if (n === 3) return { n, color: 'var(--mark-good)' };\n  return { n, color: 'var(--mark-bad)' };\n};\n\nfunction renderDay(dayEntries) {\n  const day = el('div', 'day-group');\n  const head = el('div', 'day-head');\n  head.innerHTML = `<span class=\"dot\"></span><span>${dayHeader(dayEntries[0].date)}</span>`;\n  day.appendChild(head);\n  dayEntries.forEach(e => day.appendChild(renderLesson(e)));\n  return day;\n}\nfunction dayHeader(d) {\n  return new Intl.DateTimeFormat('ru-RU', { weekday: 'long', day: 'numeric', month: 'long' }).format(d);\n}\n\nfunction renderLesson(e) {\n  const lesson = el('div', 'lesson');\n  if (e.mark) lesson.classList.add('glow');\n  lesson.style.setProperty('--glow', markGlow(e.mark));\n  const avatar = el('div', 'avatar', '<span class=\"book\">📘</span>');\n  avatar.style.background = subjColor(e.subjectId);\n  lesson.appendChild(avatar);\n  const body = el('div', 'lesson-body');\n  body.innerHTML += `<div class=\"subj\">${escapeHtml(e.subjectName)}</div>`;\n  body.innerHTML += `<div class=\"theme\">${escapeHtml(e.theme || '—')}</div>`;\n  if (e.homework) body.innerHTML += `<div class=\"homework\">✓ Д/з: ${escapeHtml(e.homework)}</div>`;\n  if (e.teacherFio) body.innerHTML += `<div class=\"teacher\">${escapeHtml(e.teacherFio)}</div>`;\n  lesson.appendChild(body);\n  if (e.mark) {\n    const st = markStat(e.mark);\n    const b = el('div', 'mark-badge', String(st.n));\n    b.style.background = hexToAlpha(bgHex(st.color));\n    b.style.color = st.color;\n    lesson.appendChild(b);\n  }\n  lesson.classList.add('clickable');\n  lesson.onclick = () => openLessonSheet(e);\n  return lesson;\n}\n// вспомогательные цветовые функции\nconst cssColorOf = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();\nfunction bgHex(varVal) {\n  if (!varVal) return '#EF5350';\n  // var(--mark-...) -> hex-цвет из темы\n  const m = varVal.match(/var\\((--[\\w-]+)\\)/);\n  if (m) return cssColorOf(m[1]) || '#EF5350';\n  return varVal;\n}\nfunction hexToAlpha(hex) {\n  let h = hex.replace('#', '');\n  if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];\n  const r = parseInt(h.slice(0,2),16), g = parseInt(h.slice(2,4),16), b = parseInt(h.slice(4,6),16);\n  return `rgba(${r},${g},${b},0.15)`;\n}\n\nconst escapeHtml = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\n\n// ---------------- Раскрывающаяся карточка урока (LessonSheet) ----------------\nlet sheetEscHandler = null;\n\nfunction openLessonSheet(e) {\n  const card = $('sheetCard');\n  const st = e.mark ? markStat(e.mark) : null;\n  const dateStr = new Intl.DateTimeFormat('ru-RU',\n    { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(e.date);\n\n  card.innerHTML =\n    '<div class=\"sheet-head\">' +\n      '<div class=\"sheet-title\">' +\n        '<div class=\"sheet-subj\">' + escapeHtml(e.subjectName) + '</div>' +\n        '<div class=\"sheet-no\">Урок №' + e.lessonNumber + '</div>' +\n      '</div>' +\n      (st\n        ? '<div class=\"mark-badge sheet-mark\" style=\"background:' + hexToAlpha(bgHex(st.color)) +\n          ';color:' + st.color + '\">' + st.n + '</div>'\n        : '') +\n      '<button class=\"sheet-close\" id=\"sheetClose\" aria-label=\"Закрыть\">✕</button>' +\n    '</div>' +\n    '<div class=\"sheet-div\"></div>' +\n    '<div class=\"sheet-field\"><div class=\"lbl\">Дата</div><div class=\"val\">' +\n      escapeHtml(dateStr) + '</div></div>' +\n    (e.teacherFio\n      ? '<div class=\"sheet-field\"><div class=\"lbl\">Учитель</div><div class=\"val\">' +\n        escapeHtml(e.teacherFio) + '</div></div>'\n      : '') +\n    '<div class=\"sheet-field\"><div class=\"lbl\">Тема урока</div><div class=\"val\">' +\n      escapeHtml(e.theme || '—') + '</div></div>' +\n    '<div class=\"lbl\" style=\"color:var(--text-secondary);font-size:13px;font-weight:700\">Домашнее задание</div>' +\n    '<div class=\"hw-box' + (e.homework ? '' : ' empty') + '\">' +\n      escapeHtml(e.homework || 'Задано не было') + '</div>';\n\n  const ov = $('sheetOverlay');\n  ov.classList.remove('hidden');\n  requestAnimationFrame(() => {\n    ov.classList.add('show');\n    card.classList.add('show');\n  });\n\n  $('sheetClose').onclick = closeLessonSheet;\n  ov.onclick = (ev) => {\n    if (ev.target === ov || ev.target.classList.contains('sheet-wrap')) closeLessonSheet();\n  };\n  sheetEscHandler = (ev) => { if (ev.key === 'Escape') closeLessonSheet(); };\n  document.addEventListener('keydown', sheetEscHandler);\n}\n\nfunction closeLessonSheet() {\n  const ov = $('sheetOverlay');\n  const card = $('sheetCard');\n  ov.classList.remove('show');\n  card.classList.remove('show');\n  if (sheetEscHandler) {\n    document.removeEventListener('keydown', sheetEscHandler);\n    sheetEscHandler = null;\n  }\n  setTimeout(() => {\n    ov.classList.add('hidden');\n    card.innerHTML = '';\n    ov.onclick = null;\n  }, 280);\n}\n\n// ---------------- Экран «Оценки» ----------------\nfunction renderMarks() {\n  const wrap = el('div');\n  const cont = el('div');\n  wrap.appendChild(cont);\n  async function load() {\n    cont.innerHTML = '<div class=\"spinner\"></div>';\n    try {\n      const sid = Prefs.studentId();\n      if (sid === -1) throw new Error('Нет данных об ученике');\n      let cid = Prefs.classId();\n      if (cid === -1) {\n        cid = await Diary.getStudentClass(sid, Prefs.uchYear());\n        Prefs.setClassId(cid);\n      }\n      const subjects = await Diary.getMarks(cid, sid, Prefs.uchYear());\n      const allNumeric = subjects.flatMap(s => s.marks).map(m => parseInt(m.mark, 10)).filter(n => !isNaN(n));\n      const avg = allNumeric.length ? allNumeric.reduce((a, b) => a + b, 0) / allNumeric.length : null;\n\n      cont.innerHTML = '';\n      cont.appendChild(renderOverall(avg));\n\n      subjects.sort((a, b) => a.subjectName.localeCompare(b.subjectName, 'ru'));\n      if (!subjects.length) {\n        cont.innerHTML += '<div class=\"state-msg\">Нет данных об оценках</div>';\n        return;\n      }\n      subjects.forEach(s => cont.appendChild(renderSubject(s)));\n    } catch (e) {\n      cont.innerHTML = `<div class=\"state-msg error\">Ошибка: ${e.message}</div>`;\n    }\n  }\n  load();\n  return wrap;\n}\n\nfunction renderOverall(avg) {\n  const card = el('div', 'overall');\n  const gradeColor = avg == null ? '#fff' : (avg >= 4.5 ? '#66BB6A' : avg >= 3.5 ? '#FFF176' : '#EF5350');\n  card.innerHTML = `<div class=\"caption\">Общий средний балл</div>` +\n    (avg == null ? '<div class=\"value\">—</div>' : `<div class=\"value\" style=\"color:${gradeColor}\">${avg.toFixed(2).replace('.', ',')}</div>`);\n  return card;\n}\n\nfunction renderSubject(s) {\n  const card = el('div', 'card subject-card');\n  const avatar = el('div', 'avatar', escapeHtml(s.subjectName.slice(0, 2)));\n  avatar.style.background = subjColor(s.subjectId);\n  const head = el('div', 'subject-head');\n  const info = el('div');\n  info.innerHTML = `<div class=\"name\">${escapeHtml(s.subjectName)}</div>` +\n    (s.teacherName ? `<div class=\"teacher\">${escapeHtml(s.teacherName)}</div>` : '');\n  head.appendChild(avatar); head.appendChild(info);\n  card.appendChild(head);\n\n  const marks = s.marks.filter(m => m.mark).sort((a, b) => a.date - b.date).slice(-20);\n  if (marks.length) {\n    const chips = el('div', 'chips');\n    marks.forEach(m => {\n      const st = markStat(m.mark);\n      const chip = el('div', 'chip', String(st.n));\n      chip.style.background = hexToAlpha(bgHex(st.color));\n      chip.style.color = st.color;\n      chips.appendChild(chip);\n    });\n    card.appendChild(chips);\n  }\n\n  const totalsArr = Object.entries(s.totalMarks).sort((a, b) => a[0] - b[0]);\n  if (totalsArr.length) {\n    const labelOf = (p) => ({ '360000': '1 четв.', '360001': '2 четв.', '360002': '3 четв.', '360003': '4 четв.', '360011': '1 полуг.', '360012': '2 полуг.' }[p] || ('Пер. ' + p));\n    card.innerHTML += `<div class=\"totals\">${totalsArr.map(([p, m]) => `${labelOf(p)}: ${escapeHtml(m)}`).join(' · ')}</div>`;\n  }\n\n  const numeric = s.marks.map(m => parseInt(m.mark, 10)).filter(n => !isNaN(n));\n  if (numeric.length) {\n    const avg = (numeric.reduce((a, b) => a + b, 0) / numeric.length).toFixed(2).replace('.', ',');\n    card.innerHTML += `<div class=\"subj-avg\">Средний: <b>${avg}</b></div>`;\n  }\n\n  // Подсказка по цели / «Узнать больше» — как в приложении\n  const goal = findGoal(s.subjectId, 'YEAR');\n  const goalMarks = goal ? goalMarksFor(s, goal.periodKey) : [];\n  const hint = goal ? goalHint(goalMarks, goal) : 'Поставь цель по предмету';\n  const achieved = goal ? goalNeeded(goalMarks, goal.targetMark, goal.allowedMarks) === 0 : false;\n  card.innerHTML += `<div class=\"goal-hint${achieved ? ' ok' : ''}\">` +\n    `<span>${escapeHtml(hint)}</span><b>Узнать больше →</b></div>`;\n\n  card.classList.add('clickable');\n  card.style.cursor = 'pointer';\n  card.onclick = () => openGoalSheet(s, 'YEAR');\n\n  return card;\n}\n\n// ---------------- Экран «Поиск» ----------------\nfunction renderSearch() {\n  const wrap = el('div');\n  const bar = el('div', 'search-bar');\n  const input = document.createElement('input');\n  input.type = 'text'; input.placeholder = 'Предмет или день недели';\n  bar.appendChild(input);\n\n  const dayNames = { 'понедельник':1,'вторник':2,'среда':3,'четверг':4,'пятница':5,'суббота':6,'воскресенье':0,\n    'пн':1,'вт':2,'ср':3,'чт':4,'пт':5,'сб':6,'вс':0 };\n\n  const ranges = [\n    () => { const { monday, sunday } = Diary.weekRange(0); return [monday, sunday]; },\n    () => { const { monday, sunday } = Diary.weekRange(1); return [monday, sunday]; },\n  ];\n  let period = ranges[0]();\n  const periodLine = el('div', 'period-line');\n  const fmtRange = () => {\n    const f = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'short' });\n    return `Период: ${f.format(period[0])} — ${f.format(period[1])}`;\n  };\n  periodLine.textContent = fmtRange();\n  periodLine.onclick = () => {\n    const modal = el('div', 'modal');\n    modal.innerHTML = '<h3>Выбор периода дней</h3>';\n    const items = ['Текущая неделя', 'Следующая неделя', '14–20 сентября', 'Вся четверть (сентябрь–октябрь)'];\n    items.forEach((label, i) => {\n      const it = el('div', 'period-item', escapeHtml(label));\n      it.onclick = () => {\n        const now = new Date();\n        if (i === 0) period = Diary.weekRange(0);\n        else if (i === 1) period = Diary.weekRange(1);\n        else if (i === 2) period = [new Date(now.getFullYear(), 8, 14), new Date(now.getFullYear(), 8, 20)];\n        else period = [new Date(now.getFullYear(), 8, 1), new Date(now.getFullYear(), 9, 31)];\n        periodLine.textContent = fmtRange();\n        hideOverlay();\n        doSearch();\n      };\n      modal.appendChild(it);\n    });\n    showOverlay(modal);\n  };\n\n  const results = el('div');\n  bar.appendChild(periodLine);\n  bar.appendChild(input);\n  wrap.appendChild(bar); wrap.appendChild(results);\n\n  async function doSearch() {\n    const query = input.value.trim().toLowerCase();\n    if (!query) return;\n    results.innerHTML = '<div class=\"spinner\"></div>';\n    const requestedDay = dayNames[query];\n    try {\n      const sid = Prefs.studentId();\n      let cid = Prefs.classId();\n      if (cid === -1) {\n        cid = await Diary.getStudentClass(sid, Prefs.uchYear());\n        Prefs.setClassId(cid);\n      }\n      const entries = await Diary.getDairy(cid, sid, period[0], period[1]);\n      const filtered = entries\n        .filter(e => e.subjectName.toLowerCase().includes(query)\n          || (requestedDay != null && e.date.getDay() === requestedDay))\n        .sort((a, b) => a.date - b.date);\n      if (!filtered.length) {\n        results.innerHTML = '<div class=\"state-msg\">Ничего не найдено</div>';\n        return;\n      }\n      results.innerHTML = '';\n      groupByDay(filtered).forEach(d => results.appendChild(renderDay(d)));\n    } catch (e) {\n      results.innerHTML = `<div class=\"state-msg error\">Ошибка: ${e.message}</div>`;\n    }\n  }\n  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') doSearch(); });\n  return wrap;\n}\n\n// ---------------- Расписание ----------------\nconst SCHEDULE_URLS = ['http://d91950hv.beget.tech/schedule.json', '../schedule.json', '/schedule.json'];\nconst SCHEDULE_DAYS = [\n  { key: 'mon', short: 'Пн', full: 'понедельник' },\n  { key: 'tue', short: 'Вт', full: 'вторник' },\n  { key: 'wed', short: 'Ср', full: 'среду' },\n  { key: 'thu', short: 'Чт', full: 'четверг' },\n  { key: 'fri', short: 'Пт', full: 'пятницу' },\n  { key: 'sat', short: 'Сб', full: 'субботу' }\n];\nconst CLASS_KEY = 'diary_selected_class';\n\nfunction scheduleTodayKey() {\n  const map = ['mon', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat']; // getDay(): 0=вс\n  return map[new Date().getDay()] || 'mon';\n}\n\nasync function fetchSchedule() {\n  let lastErr = null;\n  for (const u of SCHEDULE_URLS) {\n    try {\n      const r = await fetch(u, { cache: 'no-store' });\n      if (!r.ok) throw new Error('HTTP ' + r.status);\n      return await r.json();\n    } catch (e) { lastErr = e; }\n  }\n  throw lastErr || new Error('Сайт с расписанием недоступен');\n}\n\nfunction renderSchedule() {\n  const wrap = el('div');\n  let dayKey = scheduleTodayKey();\n  let className = localStorage.getItem(CLASS_KEY) || '';\n\n  async function load() {\n    wrap.innerHTML = '<div class=\"spinner\"></div>';\n    try {\n      const sch = await fetchSchedule();\n      const classes = (sch && sch.classes) || [];\n      if (!className || classes.indexOf(className) === -1) {\n        className = classes[0] || '';\n        if (className) localStorage.setItem(CLASS_KEY, className);\n      }\n      paint(sch, classes);\n    } catch (e) {\n      wrap.innerHTML = '<div class=\"state-msg error\">Сайт с расписанием недоступен<br>'\n        + '<span style=\"font-size:13px\">' + escapeHtml(e.message) + '</span></div>';\n    }\n  }\n\n  function paint(sch, classes) {\n    wrap.innerHTML = '';\n\n    const head = el('div', 'sched-head');\n    head.innerHTML = '<b>Класс: ' + escapeHtml(className || 'не выбран') + '</b>' +\n      '<span>сменить в настройках</span>';\n    wrap.appendChild(head);\n\n    const days = el('div', 'sched-days');\n    SCHEDULE_DAYS.forEach(d => {\n      const b = el('button', 'sched-day' + (d.key === dayKey ? ' sel' : ''), d.short);\n      b.onclick = () => { dayKey = d.key; paint(sch, classes); };\n      days.appendChild(b);\n    });\n    wrap.appendChild(days);\n\n    const list = el('div', 'sched-list');\n    const lessons = (((sch.lessons || {})[className] || {})[dayKey] || []).slice()\n      .sort((a, b) => a.n - b.n);\n    const bells = ((dayKey === 'sat' ? (sch.bells || {}).saturday : (sch.bells || {}).weekday) || []);\n    const dayFull = (SCHEDULE_DAYS.find(d => d.key === dayKey) || {}).full || '';\n\n    if (!lessons.length) {\n      list.innerHTML = '<div class=\"state-msg\">На ' + escapeHtml(dayFull) + ' уроков нет</div>';\n    } else {\n      lessons.forEach(l => {\n        const bell = bells.find(b => b.n === l.n) || {};\n        const details = [l.teacher, l.room ? 'каб. ' + l.room : null]\n          .filter(Boolean).map(escapeHtml).join(' · ');\n        const row = el('div', 'sched-lesson');\n        row.innerHTML =\n          '<div class=\"sched-num\"><b>' + l.n + '</b>' +\n            (bell.start ? '<span>' + escapeHtml(bell.start) + '</span>' : '') +\n            (bell.end ? '<i>' + escapeHtml(bell.end) + '</i>' : '') +\n          '</div>' +\n          '<div class=\"sched-info\"><div class=\"sched-subj\">' + escapeHtml(l.subject || '') + '</div>' +\n            (details ? '<div class=\"sched-det\">' + details + '</div>' : '') +\n          '</div>';\n        list.appendChild(row);\n      });\n    }\n    wrap.appendChild(list);\n  }\n\n  load();\n  return wrap;\n}\n\n// ---------------- Уведомления ----------------\nconst NOTIF_KEY = 'diary_notifications';\nconst NOTIF_MAX = 200;\nlet notifChecking = false;\n\nfunction loadNotifications() {\n  try { const a = JSON.parse(localStorage.getItem(NOTIF_KEY) || '[]'); return Array.isArray(a) ? a : []; }\n  catch (e) { return []; }\n}\nfunction saveNotifications(list) { localStorage.setItem(NOTIF_KEY, JSON.stringify(list.slice(0, NOTIF_MAX))); }\nfunction unreadNotifications() { return loadNotifications().filter(n => !n.read).length; }\nfunction appendNotification(title, text, channel, tab) {\n  const list = loadNotifications();\n  list.unshift({ id: Date.now(), title: title, text: text, channel: channel, time: Date.now(), read: false, tab: tab });\n  saveNotifications(list);\n  updateBell();\n}\nfunction markAllRead() {\n  const list = loadNotifications();\n  if (!list.some(n => !n.read)) return;\n  saveNotifications(list.map(n => ({ ...n, read: true })));\n}\nfunction markRead(id) { saveNotifications(loadNotifications().map(n => n.id === id ? { ...n, read: true } : n)); }\nfunction clearNotifications() { saveNotifications([]); }\n\nfunction updateBell() {\n  const b = $('bellBadge');\n  if (!b) return;\n  const n = unreadNotifications();\n  b.textContent = n > 9 ? '9+' : String(n);\n  b.classList.toggle('hidden', n === 0);\n}\n\nfunction ddmm(d) {\n  const p = n => String(n).padStart(2, '0');\n  return p(d.getDate()) + '.' + p(d.getMonth() + 1) + '.' + d.getFullYear();\n}\n\nasync function checkNotifications() {\n  if (notifChecking) return;\n  notifChecking = true;\n\n  // События: сравниваем id\n  try {\n    const events = await fetchEvents();\n    if (events.length) {\n      const ids = events.map(e => e.id).sort().join('\\n');\n      const old = localStorage.getItem('diary_notif_events');\n      if (old == null) {\n        localStorage.setItem('diary_notif_events', ids);\n      } else {\n        const oldSet = new Set(old.split('\\n').filter(Boolean));\n        const fresh = events.filter(e => !oldSet.has(e.id));\n        localStorage.setItem('diary_notif_events', ids);\n        if (fresh.length) {\n          const title = fresh.length === 1 ? 'Новое событие' : 'Новые события (' + fresh.length + ')';\n          const text = fresh\n            .sort((a, b) => String(a.date || '').localeCompare(String(b.date || '')))\n            .map(e => '• ' + e.title + (e.date ? ' (' + formatEventDate(e.date) + ')' : ''))\n            .join('\\n');\n          appendNotification(title, text, 'events', 'events');\n        }\n      }\n    }\n  } catch (e) { /* сайт недоступен — молча */ }\n\n  // Дневник: новые оценки и домашние задания за 3 дня\n  try {\n    const sid = Prefs.studentId();\n    if (sid !== -1) {\n      let cid = Prefs.classId();\n      if (cid === -1) { cid = await Diary.getStudentClass(sid, Prefs.uchYear()); Prefs.setClassId(cid); }\n      const end = new Date();\n      const begin = new Date(); begin.setDate(begin.getDate() - 3);\n      const entries = await Diary.getDairy(cid, sid, begin, end);\n      if (entries.length) {\n        const keys = [];\n        const nameMap = {};\n        entries.forEach(en => {\n          nameMap[en.subjectId] = en.subjectName;\n          const ds = ddmm(en.date);\n          if (en.mark) keys.push('M:' + en.subjectId + '|' + ds + '|' + en.lessonNumber + '|' + en.mark);\n          if (en.homework) keys.push('H:' + en.subjectId + '|' + ds + '|' + en.lessonNumber + '|' + en.homework);\n        });\n        const cur = keys.slice().sort().join('\\n');\n        const oldRaw = localStorage.getItem('diary_notif_keys');\n        if (oldRaw == null) {\n          localStorage.setItem('diary_notif_keys', cur);\n        } else {\n          const oldSet = new Set(oldRaw.split('\\n').filter(Boolean));\n          const fresh = keys.filter(k => !oldSet.has(k));\n          localStorage.setItem('diary_notif_keys', cur);\n          if (fresh.length) {\n            const lines = fresh.sort().map(k => {\n              const p = k.split('|');\n              const subj = nameMap[p[0].replace(/^[MH]:/, '')] || 'Предмет';\n              return p[0].charAt(0) === 'M'\n                ? subj + ': новая оценка ' + p[3]\n                : subj + ': ' + p[3].slice(0, 120);\n            });\n            const title = lines.length === 1 ? 'Новое в дневнике' : 'Новое в дневнике (' + lines.length + ')';\n            appendNotification(title, lines.join('\\n'), 'diary', 'dairy');\n          }\n        }\n      }\n    }\n  } catch (e) { /* нет сети — молча */ }\n\n  notifChecking = false;\n  updateBell();\n}\n\nfunction renderNotifications() {\n  const wrap = el('div');\n  const items = loadNotifications();\n  const unreadIds = new Set(items.filter(n => !n.read).map(n => n.id));\n\n  const head = el('div', 'notif-head');\n  const back = el('button', 'notif-back', '←');\n  back.title = 'Назад';\n  back.onclick = () => { state.tab = 'settings'; renderCurrent(); };\n  head.appendChild(back);\n  const ttl = el('b', '', 'Уведомления');\n  head.appendChild(ttl);\n  const sp = el('div'); sp.style.flex = '1'; head.appendChild(sp);\n  if (items.length) {\n    const clear = el('button', 'btn secondary small', 'Очистить');\n    clear.onclick = () => { clearNotifications(); updateBell(); renderCurrent(); };\n    head.appendChild(clear);\n  }\n  wrap.appendChild(head);\n\n  if (!items.length) {\n    const empty = el('div', 'state-msg');\n    empty.innerHTML = '<div style=\"font-size:40px;opacity:.4\">🔔</div>Уведомлений пока нет';\n    wrap.appendChild(empty);\n  } else {\n    items.forEach(n => wrap.appendChild(renderNotifRow(n, unreadIds.has(n.id))));\n  }\n\n  // как в приложении: при открытии всё считается прочитанным\n  if (unreadIds.size) { markAllRead(); updateBell(); }\n  return wrap;\n}\n\nfunction renderNotifRow(n, unread) {\n  const row = el('div', 'notif-row' + (unread ? ' unread' : ''));\n  const ico = n.channel === 'events' ? '📅' : n.channel === 'update' ? '⬆️' : '📖';\n  const col = n.channel === 'events' ? '#4DB6AC' : n.channel === 'update' ? '#9575CD' : '#7E57C2';\n  const d = new Date(n.time);\n  const time = d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit' }) + ', ' +\n    d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });\n  row.innerHTML = '<div class=\"notif-ico\" style=\"background:' + col + '22;color:' + col + '\">' + ico + '</div>' +\n    '<div class=\"notif-body\">' +\n      '<div class=\"notif-title\">' + escapeHtml(n.title) + '</div>' +\n      '<div class=\"notif-text\">' + escapeHtml(n.text).replace(/\\n/g, '<br>') + '</div>' +\n      '<div class=\"notif-time\">' + escapeHtml(time) + '</div>' +\n    '</div>';\n  row.onclick = () => {\n    markRead(n.id);\n    const t = n.tab;\n    state.tab = (t === 'events' || t === 'goals' || t === 'marks' || t === 'schedule') ? t : 'dairy';\n    renderCurrent();\n  };\n  return row;\n}\n\n// ---------------- Цели ----------------\nconst GOALS_KEY = 'diary_goals';\nconst GOAL_PERIODS = [\n  { key: 'Q1', label: '1 четверть', ids: [360000] },\n  { key: 'Q2', label: '2 четверть', ids: [360001] },\n  { key: 'Q3', label: '3 четверть', ids: [360002] },\n  { key: 'Q4', label: '4 четверть', ids: [360003] },\n  { key: 'H1', label: '1 полугодие', ids: [360000, 360001] },\n  { key: 'H2', label: '2 полугодие', ids: [360002, 360003] },\n  { key: 'YEAR', label: 'Учебный год', ids: [] }\n];\n\nfunction goalPeriod(key) {\n  return GOAL_PERIODS.find(p => p.key === key) || GOAL_PERIODS[GOAL_PERIODS.length - 1];\n}\nfunction loadGoals() {\n  try { const a = JSON.parse(localStorage.getItem(GOALS_KEY) || '[]'); return Array.isArray(a) ? a : []; }\n  catch (e) { return []; }\n}\nfunction saveGoals(list) { localStorage.setItem(GOALS_KEY, JSON.stringify(list)); }\nfunction findGoal(subjectId, periodKey) {\n  return loadGoals().find(g => g.subjectId === subjectId && g.periodKey === periodKey) || null;\n}\nfunction upsertGoal(goal) {\n  const list = loadGoals().filter(g => !(g.subjectId === goal.subjectId && g.periodKey === goal.periodKey));\n  list.push(goal);\n  saveGoals(list);\n}\nfunction removeGoal(subjectId, periodKey) {\n  saveGoals(loadGoals().filter(g => !(g.subjectId === subjectId && g.periodKey === periodKey)));\n}\n\nfunction goalThreshold(t) { return t === 5 ? 4.5 : t === 4 ? 3.5 : t === 3 ? 2.5 : 1.5; }\n\nfunction goalMarksFor(subject, periodKey) {\n  const p = goalPeriod(periodKey);\n  const withPeriod = subject.marks.filter(m => m.periodId != null);\n  let filtered;\n  if (!p.ids.length) filtered = subject.marks;\n  else if (!withPeriod.length) filtered = subject.marks;\n  else filtered = subject.marks.filter(m => p.ids.includes(m.periodId));\n  return filtered.map(m => parseInt(m.mark, 10)).filter(n => !isNaN(n));\n}\nfunction goalAverage(marks) {\n  return marks.length ? marks.reduce((a, b) => a + b, 0) / marks.length : null;\n}\nfunction goalRounded(avg) {\n  if (avg == null) return null;\n  return avg >= 4.5 ? 5 : avg >= 3.5 ? 4 : avg >= 2.5 ? 3 : 2;\n}\nfunction goalNeeded(marks, target, allowed) {\n  if (!allowed || !allowed.length) return null;\n  const t = goalThreshold(target);\n  const n = marks.length;\n  const sum = marks.reduce((a, b) => a + b, 0);\n  if (n > 0 && sum / n >= t) return 0;\n  if (n === 0 && t <= 0) return 0;\n  const best = Math.max.apply(null, allowed);\n  if (best < t) return null;\n  const k = Math.ceil((t * n - sum) / (best - t));\n  return Math.max(1, k);\n}\nfunction goalHint(marks, goal) {\n  const need = goalNeeded(marks, goal.targetMark, goal.allowedMarks);\n  const avg = goalAverage(marks);\n  const avgText = avg == null ? 'нет оценок' : avg.toFixed(2).replace('.', ',');\n  if (need == null) return 'С набором ' + goal.allowedMarks.join('/') + ' цели не достичь';\n  if (need === 0) return 'Цель достигнута! Средний: ' + avgText;\n  const best = Math.max.apply(null, goal.allowedMarks);\n  return 'Нужно ещё ' + need + ' × «' + best + '». Сейчас средний: ' + avgText;\n}\nfunction goalPlural(n) {\n  const m10 = n % 10, m100 = n % 100;\n  if (m10 === 1 && m100 !== 11) return 'ку';\n  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return 'ки';\n  return 'ок';\n}\n\nasync function loadSubjects() {\n  const sid = Prefs.studentId();\n  if (sid === -1) throw new Error('Нет данных об ученике');\n  let cid = Prefs.classId();\n  if (cid === -1) {\n    cid = await Diary.getStudentClass(sid, Prefs.uchYear());\n    Prefs.setClassId(cid);\n  }\n  return await Diary.getMarks(cid, sid, Prefs.uchYear());\n}\n\nfunction renderGoals() {\n  const wrap = el('div');\n  const cont = el('div');\n  wrap.appendChild(cont);\n\n  async function load() {\n    cont.innerHTML = '<div class=\"spinner\"></div>';\n    try {\n      const subjects = await loadSubjects();\n      const byId = {};\n      subjects.forEach(s => { byId[s.subjectId] = s; });\n      const goals = loadGoals();\n\n      cont.innerHTML = '';\n      cont.appendChild(el('div', 'goals-title', 'Мои цели'));\n\n      if (!goals.length) {\n        const empty = el('div', 'goal-empty');\n        empty.innerHTML = '<div class=\"flag\">🚩</div><b>Целей пока нет</b>' +\n          '<div style=\"margin-top:6px;font-size:14px\">Открой «Оценки» → выбери предмет → «Узнать больше» и поставь цель</div>';\n        cont.appendChild(empty);\n        return;\n      }\n      goals.sort((a, b) => a.subjectName.localeCompare(b.subjectName, 'ru'));\n      goals.forEach(g => cont.appendChild(renderGoalCard(g, byId[g.subjectId])));\n    } catch (e) {\n      cont.innerHTML = '<div class=\"state-msg error\">Ошибка: ' + escapeHtml(e.message) + '</div>';\n    }\n  }\n  load();\n  return wrap;\n}\n\nfunction renderGoalCard(goal, subject) {\n  const card = el('div', 'card subject-card');\n  const marks = subject ? goalMarksFor(subject, goal.periodKey) : [];\n  const hint = subject ? goalHint(marks, goal) : 'Нет данных об оценках';\n  const achieved = subject ? goalNeeded(marks, goal.targetMark, goal.allowedMarks) === 0 : false;\n\n  const head = el('div', 'goal-head');\n  const av = el('div', 'avatar', escapeHtml(goal.subjectName.slice(0, 2)));\n  av.style.background = subjColor(goal.subjectId);\n  head.appendChild(av);\n\n  const meta = el('div', 'goal-meta');\n  meta.innerHTML = '<div class=\"name\">' + escapeHtml(goal.subjectName) + '</div>' +\n    '<div class=\"sub\">' + escapeHtml(goalPeriod(goal.periodKey).label) + ' · цель «' + goal.targetMark + '»</div>';\n  head.appendChild(meta);\n\n  const st = markStat(String(goal.targetMark));\n  const tb = el('div', 'goal-target', String(goal.targetMark));\n  tb.style.background = hexToAlpha(bgHex(st.color));\n  tb.style.color = st.color;\n  head.appendChild(tb);\n\n  const del = el('button', 'goal-del', '✕');\n  del.title = 'Удалить цель';\n  del.onclick = (e) => {\n    e.stopPropagation();\n    removeGoal(goal.subjectId, goal.periodKey);\n    renderCurrent();\n  };\n  head.appendChild(del);\n  card.appendChild(head);\n\n  const hb = el('div', 'goal-hint' + (achieved ? ' ok' : ''));\n  hb.innerHTML = '<span>' + escapeHtml(hint) + '</span><b>Узнать больше</b>';\n  card.appendChild(hb);\n\n  card.classList.add('clickable');\n  card.style.cursor = 'pointer';\n  card.onclick = () => { if (subject) openGoalSheet(subject, goal.periodKey); };\n  return card;\n}\n\n// ---------------- Карточка цели (полный экран) ----------------\nfunction showSheetCard(html) {\n  const card = $('sheetCard');\n  card.innerHTML = html;\n  const ov = $('sheetOverlay');\n  ov.classList.remove('hidden');\n  requestAnimationFrame(() => { ov.classList.add('show'); card.classList.add('show'); });\n  ov.onclick = (ev) => { if (ev.target === ov || ev.target.classList.contains('sheet-wrap')) closeLessonSheet(); };\n  if (sheetEscHandler) { document.removeEventListener('keydown', sheetEscHandler); sheetEscHandler = null; }\n  sheetEscHandler = (ev) => { if (ev.key === 'Escape') closeLessonSheet(); };\n  document.addEventListener('keydown', sheetEscHandler);\n}\n\nfunction openGoalSheet(subject, initialPeriodKey) {\n  const existing = findGoal(subject.subjectId, initialPeriodKey || 'YEAR');\n  const gs = {\n    periodKey: initialPeriodKey || (existing && existing.periodKey) || 'YEAR',\n    targetMark: existing ? existing.targetMark : 5,\n    allowed: new Set(existing ? existing.allowedMarks : [5])\n  };\n\n  function paint() {\n    const marks = goalMarksFor(subject, gs.periodKey);\n    const avg = goalAverage(marks);\n    const rounded = goalRounded(avg);\n    const allowedArr = Array.from(gs.allowed);\n    const needed = goalNeeded(marks, gs.targetMark, allowedArr);\n    const avgText = avg == null ? '—' : avg.toFixed(2).replace('.', ',');\n\n    const marksChips = marks.length\n      ? marks.map(m => {\n          const st = markStat(String(m));\n          return '<span class=\"gs-chip\" style=\"background:' + hexToAlpha(bgHex(st.color)) + ';color:' + st.color + '\">' + m + '</span>';\n        }).join('')\n      : '<span style=\"color:var(--text-secondary);font-size:14px\">Оценок за этот период нет</span>';\n\n    let resultText, resultClass;\n    if (!allowedArr.length) { resultText = 'Выбери хотя бы одну оценку'; resultClass = 'err'; }\n    else if (needed == null) { resultText = 'С такими оценками цель недостижима'; resultClass = 'err'; }\n    else if (needed === 0) { resultText = 'Цель уже достигнута — средний балл достаточно высокий'; resultClass = 'ok'; }\n    else {\n      resultText = 'Нужно ещё ' + needed + ' оцен' + goalPlural(needed) + ' «' + Math.max.apply(null, allowedArr) + '», чтобы выйти на «' + gs.targetMark + '»';\n      resultClass = 'todo';\n    }\n\n    const saved = findGoal(subject.subjectId, gs.periodKey);\n    const periodOpts = GOAL_PERIODS.map(p =>\n      '<option value=\"' + p.key + '\"' + (p.key === gs.periodKey ? ' selected' : '') + '>' + escapeHtml(p.label) + '</option>'\n    ).join('');\n\n    const html =\n      '<div class=\"gs-head\">' +\n        '<div style=\"flex:1;min-width:0\"><div class=\"tsub\">Цель по предмету</div><div class=\"ttl\">' + escapeHtml(subject.subjectName) + '</div></div>' +\n        '<button class=\"gs-close\" id=\"goalClose\" aria-label=\"Закрыть\">✕</button>' +\n      '</div>' +\n      '<div class=\"gs-block\"><div class=\"bl\">Текущие оценки</div><div class=\"gs-chips\">' + marksChips + '</div>' +\n        (marks.length ? '<div class=\"gs-avg\">Средний: ' + avgText + (rounded ? ' · тянет на «' + rounded + '»' : '') + '</div>' : '') +\n      '</div>' +\n      '<div class=\"gs-block\"><div class=\"bl\">За какой период</div>' +\n        '<select class=\"gs-select\" id=\"goalPeriod\">' + periodOpts + '</select>' +\n      '</div>' +\n      '<div class=\"gs-block\"><div class=\"bl\">Какую оценку хочешь</div><div class=\"gs-row\">' +\n        [5, 4, 3].map(m => '<button class=\"gs-choice' + (gs.targetMark === m ? ' sel' : '') + '\" data-target=\"' + m + '\">' + m + '</button>').join('') +\n      '</div></div>' +\n      '<div class=\"gs-block\"><div class=\"bl\">Какими оценками набирать</div><div class=\"gs-row\">' +\n        [5, 4, 3, 2].map(m => '<button class=\"gs-choice' + (gs.allowed.has(m) ? ' sel' : '') + '\" data-allowed=\"' + m + '\">' + m + '</button>').join('') +\n      '</div><div class=\"gs-note\">Можно выбрать несколько — посчитаем по лучшей из них</div></div>' +\n      '<div class=\"gs-result ' + resultClass + '\">' + escapeHtml(resultText) + '</div>' +\n      '<button class=\"btn primary gs-btn\" id=\"goalSave\"' + (gs.allowed.size ? '' : ' disabled') + '>Установить цель</button>' +\n      (saved ? '<button class=\"btn destructive gs-btn\" id=\"goalDelete\">Удалить цель</button>' : '');\n\n    showSheetCard(html);\n\n    $('goalClose').onclick = closeLessonSheet;\n    $('goalPeriod').onchange = (e) => { gs.periodKey = e.target.value; paint(); };\n    $('sheetCard').querySelectorAll('[data-target]').forEach(b => {\n      b.onclick = () => { gs.targetMark = parseInt(b.getAttribute('data-target'), 10); paint(); };\n    });\n    $('sheetCard').querySelectorAll('[data-allowed]').forEach(b => {\n      b.onclick = () => {\n        const v = parseInt(b.getAttribute('data-allowed'), 10);\n        if (gs.allowed.has(v)) gs.allowed.delete(v); else gs.allowed.add(v);\n        paint();\n      };\n    });\n    $('goalSave').onclick = () => {\n      if (!gs.allowed.size) return;\n      upsertGoal({\n        subjectId: subject.subjectId,\n        subjectName: subject.subjectName,\n        periodKey: gs.periodKey,\n        targetMark: gs.targetMark,\n        allowedMarks: Array.from(gs.allowed).sort((a, b) => b - a)\n      });\n      closeLessonSheet();\n      if (state.tab === 'marks' || state.tab === 'goals') renderCurrent();\n    };\n    const del = $('goalDelete');\n    if (del) del.onclick = () => {\n      removeGoal(subject.subjectId, gs.periodKey);\n      closeLessonSheet();\n      if (state.tab === 'marks' || state.tab === 'goals') renderCurrent();\n    };\n  }\n  paint();\n}\n\n// ---------------- Экран «События» ----------------\nconst EVENTS_URLS = ['http://d91950hv.beget.tech/events.json', '../events.json', '/events.json'];\n\nasync function fetchEvents() {\n  let lastErr = null;\n  for (const u of EVENTS_URLS) {\n    try {\n      const r = await fetch(u, { cache: 'no-store' });\n      if (!r.ok) throw new Error('HTTP ' + r.status);\n      const j = await r.json();\n      return (j && Array.isArray(j.events)) ? j.events : [];\n    } catch (e) { lastErr = e; }\n  }\n  throw lastErr || new Error('Не удалось загрузить события');\n}\n\nfunction formatEventDate(s) {\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(s || ''));\n  if (!m) return String(s || '');\n  const d = new Date(+m[1], +m[2] - 1, +m[3]);\n  return new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);\n}\n\nfunction renderEvents() {\n  const wrap = el('div');\n  const top = el('div', 'events-top');\n  const qr = el('button', 'btn secondary', '📷 Сканировать QR-код');\n  qr.style.width = '100%';\n  qr.onclick = openQrScanner;\n  top.appendChild(qr);\n\n  const cont = el('div');\n  wrap.appendChild(top);\n  wrap.appendChild(cont);\n\n  async function load() {\n    cont.innerHTML = '<div class=\"spinner\"></div>';\n    try {\n      const events = await fetchEvents();\n      if (!events.length) {\n        cont.innerHTML = '<div class=\"state-msg\">Событий пока нет</div>';\n        return;\n      }\n      events.sort((a, b) => String(a.date || '').localeCompare(String(b.date || '')));\n      cont.innerHTML = '';\n      events.forEach(ev => cont.appendChild(renderEventCard(ev)));\n    } catch (e) {\n      cont.innerHTML = '<div class=\"state-msg error\">Не удалось загрузить события<br>'\n        + '<span style=\"font-size:13px\">' + escapeHtml(e.message) + '</span></div>';\n    }\n  }\n  load();\n  return wrap;\n}\n\nfunction renderEventCard(ev) {\n  const card = el('div', 'event');\n  const head = el('div', 'event-head');\n  head.appendChild(el('div', 'event-badge', '📅'));\n  head.appendChild(el('div', 'event-title', escapeHtml(ev.title || '')));\n  if (ev.link) head.appendChild(el('span', 'event-arrow', '→'));\n  card.appendChild(head);\n\n  if (ev.date) card.appendChild(el('div', 'event-date', escapeHtml(formatEventDate(ev.date))));\n\n  if (ev.image) {\n    const img = document.createElement('img');\n    img.className = 'event-img';\n    img.loading = 'lazy';\n    img.alt = '';\n    img.src = ev.image;\n    img.onerror = () => img.remove(); // как в приложении: битая картинка не оставляет пустой блок\n    card.appendChild(img);\n  }\n  if (ev.text) card.appendChild(el('div', 'event-text', escapeHtml(ev.text)));\n\n  if (ev.link) {\n    card.classList.add('clickable');\n    card.onclick = () => window.open(ev.link, '_blank', 'noopener');\n  }\n  return card;\n}\n\n// ---------------- QR-сканер ----------------\nfunction openQrScanner() {\n  const modal = el('div', 'modal');\n  modal.innerHTML = '<h3>Сканировать QR-код</h3>';\n\n  const note = el('div', 'muted');\n  const video = document.createElement('video');\n  video.className = 'qr-video';\n  video.setAttribute('playsinline', '');\n  video.muted = true;\n\n  const manual = el('div', 'qr-manual');\n  manual.appendChild(el('div', 'muted', 'Или вставьте ссылку:'));\n  const inp = document.createElement('input');\n  inp.type = 'text';\n  inp.placeholder = 'https://…';\n  const go = el('button', 'btn primary', 'Открыть');\n  const actions = el('div', 'modal-actions');\n  const cancel = el('button', 'btn secondary', 'Закрыть');\n  actions.appendChild(cancel);\n\n  manual.appendChild(inp);\n  manual.appendChild(go);\n  modal.appendChild(note);\n  modal.appendChild(video);\n  modal.appendChild(manual);\n  modal.appendChild(actions);\n  showOverlay(modal);\n\n  let stream = null, timer = 0;\n  function cleanup() {\n    if (timer) { clearInterval(timer); timer = 0; }\n    if (stream) { stream.getTracks().forEach(t => { try { t.stop(); } catch (e) {} }); stream = null; }\n  }\n  function close() {\n    cleanup();\n    overlay().onclick = null;\n    hideOverlay();\n  }\n  cancel.onclick = close;\n  overlay().onclick = (e) => { if (e.target === overlay()) close(); };\n\n  go.onclick = () => {\n    const v = inp.value.trim();\n    if (!v) { inp.focus(); return; }\n    window.open(v, '_blank', 'noopener');\n    close();\n  };\n  inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') go.click(); });\n\n  async function start() {\n    if (!('BarcodeDetector' in window)) {\n      note.textContent = 'Этот браузер не умеет сканировать QR. Вставьте ссылку вручную.';\n      return;\n    }\n    try {\n      const detector = new window.BarcodeDetector({ formats: ['qr_code'] });\n      stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });\n      video.srcObject = stream;\n      await video.play();\n      note.textContent = 'Наведите камеру на QR-код';\n      timer = setInterval(async () => {\n        try {\n          const codes = await detector.detect(video);\n          if (codes && codes.length) {\n            const raw = (codes[0].rawValue || '').trim();\n            if (!raw) return;\n            cleanup();\n            if (/^https?:\\/\\//i.test(raw)) {\n              window.open(raw, '_blank', 'noopener');\n            } else {\n              alert('Считано: ' + raw);\n            }\n            close();\n          }\n        } catch (e) { /* кадр не распознан — пробуем следующий */ }\n      }, 350);\n    } catch (e) {\n      note.textContent = 'Не удалось включить камеру: ' + e.message + '. Вставьте ссылку вручную.';\n    }\n  }\n  start();\n}\n\n// ---------------- Экран «Настройки» ----------------\nfunction renderSettings() {\n  const wrap = el('div');\n  const cont = el('div');\n  wrap.appendChild(cont);\n  cont.style.padding = '16px';\n\n  // Аккаунт\n  const acc = el('div', 'card section');\n  acc.innerHTML = '<h3>Аккаунт</h3>';\n  const lInput = document.createElement('input'); lInput.type = 'text'; lInput.value = Prefs.login(); lInput.placeholder = 'Логин';\n  const pInput = document.createElement('input'); pInput.type = 'password'; pInput.value = Prefs.password(); pInput.placeholder = 'Пароль';\n  acc.appendChild(lInput); acc.appendChild(pInput);\n  const saveBtn = el('button', 'btn primary', 'Сохранить');\n  saveBtn.onclick = () => {\n    if (lInput.value.trim() && pInput.value) {\n      Prefs.saveCredentials(lInput.value.trim(), pInput.value, Prefs.studentId());\n      Diary.restoreSession(lInput.value.trim(), pInput.value);\n      alert('Данные сохранены');\n    } else alert('Введите логин и пароль');\n  };\n  acc.appendChild(saveBtn);\n\n  // Тема\n  const theme = el('div', 'card section');\n  theme.innerHTML = '<h3>Тема оформления</h3>';\n  ['system', 'light', 'dark', 'zhan'].forEach(t => {\n    const names = { system: 'Системная', light: 'Светлая', dark: 'Тёмная', zhan: 'Альтернативная' };\n    const b = document.createElement('button');\n    b.className = 'btn ' + (getTheme() === t ? 'primary' : 'secondary');\n    b.style.marginBottom = '6px';\n    b.textContent = names[t];\n    b.onclick = () => { setTheme(t); alert('Тема изменена'); renderCurrent(); };\n    theme.appendChild(b);\n  });\n\n  // Расписание — свой класс\n  const sched = el('div', 'card section');\n  sched.innerHTML = '<h3>Расписание</h3>' +\n    '<div class=\"muted\" style=\"font-size:13px;margin-bottom:8px\">Класс для показа расписания</div>';\n  const classSel = document.createElement('select');\n  classSel.className = 'gs-select';\n  classSel.innerHTML = '<option value=\"\">Не выбран</option>';\n  classSel.onchange = () => {\n    if (classSel.value) localStorage.setItem(CLASS_KEY, classSel.value);\n    else localStorage.removeItem(CLASS_KEY);\n  };\n  sched.appendChild(classSel);\n  fetchSchedule().then(sch => {\n    const classes = (sch && sch.classes) || [];\n    const cur = localStorage.getItem(CLASS_KEY) || '';\n    if (!classes.length) { classSel.innerHTML = '<option value=\"\">Список классов не загружен</option>'; return; }\n    classSel.innerHTML = '<option value=\"\">Не выбран</option>' + classes.map(c =>\n      '<option value=\"' + escapeHtml(c) + '\"' + (c === cur ? ' selected' : '') + '>' +\n      escapeHtml(c) + '</option>').join('');\n  }).catch(() => { classSel.innerHTML = '<option value=\"\">Список классов не загружен</option>'; });\n\n  // Уведомления\n  const notif = el('div', 'card section');\n  const unread = unreadNotifications();\n  notif.innerHTML = '<h3>Уведомления</h3>' +\n    '<div class=\"muted\" style=\"font-size:13px;margin-bottom:10px\">' +\n    (unread ? 'Непрочитанных: ' + unread : 'Новых уведомлений нет') + '</div>';\n  const openNotif = el('button', 'btn secondary', 'Открыть центр уведомлений');\n  openNotif.onclick = () => { state.tab = 'notifications'; renderCurrent(); };\n  notif.appendChild(openNotif);\n  if (loadNotifications().length) {\n    const clr = el('button', 'btn destructive small', 'Очистить историю');\n    clr.style.marginTop = '8px';\n    clr.onclick = () => { clearNotifications(); updateBell(); renderCurrent(); };\n    notif.appendChild(clr);\n  }\n\n  // Версия и выход\n  const ver = el('div', 'card section');\n  ver.innerHTML = '<h3>Веб-версия 2.6.14web</h3>';\n  const logout = el('button', 'btn destructive', 'Выйти из аккаунта');\n  logout.onclick = () => {\n    Prefs.clearCredentials();\n    Diary.restoreSession('', '');\n    showLogin();\n  };\n  ver.appendChild(logout);\n\n  cont.appendChild(acc);\n  cont.appendChild(theme);\n  cont.appendChild(sched);\n  cont.appendChild(notif);\n  cont.appendChild(ver);\n  return wrap;\n}\n\n// ---------------- Вход ----------------\nasync function doLogin() {\n  const l = $('loginField').value.trim();\n  const p = $('passwordField').value;\n  const err = $('loginError');\n  if (!l || !p) { err.textContent = 'Введите логин и пароль'; err.classList.remove('hidden'); return; }\n  const btn = $('loginBtn');\n  btn.disabled = true; btn.textContent = 'Вход…';\n  err.classList.add('hidden');\n  try {\n    const info = await Diary.login(l, p);\n    if (!info) {\n      err.textContent = 'Неверный логин или пароль';\n      err.classList.remove('hidden');\n      return;\n    }\n    Prefs.saveCredentials(l, p, info.studentId);\n    Prefs.setUserId(info.userId);\n    const year = await Diary.getUchYear();\n    Prefs.setUchYear(year);\n    showApp();\n  } catch (e) {\n    err.textContent = 'Ошибка: ' + e.message;\n    err.classList.remove('hidden');\n  } finally {\n    btn.disabled = false; btn.textContent = 'Войти';\n  }\n}\n\nfunction showLogin() {\n  $('loginScreen').classList.remove('hidden');\n  $('appScreen').classList.add('hidden');\n}\n\n// ---------------- Переключение экранов ----------------\n// Порядок как в приложении: Дневник · Оценки · События · Настройки\nconst TAB_ORDER = ['dairy', 'schedule', 'marks', 'goals', 'events', 'settings'];\nlet lastTabIndex = 0;\nlet transitionToken = 0;\n\nfunction settleScreens(screens) {\n  const kids = Array.prototype.slice.call(screens.children);\n  if (kids.length > 1) kids.slice(0, -1).forEach(k => k.remove());\n  kids.forEach(k => k.classList && k.classList.remove(\n    'enter-from-right', 'enter-from-left', 'in', 'leave-to-left', 'leave-to-right', 'out'));\n  screens.classList.remove('transitioning');\n}\n\nfunction buildScreen(t) {\n  if (t === 'dairy') return renderDairy();\n  if (t === 'schedule') return renderSchedule();\n  if (t === 'marks') return renderMarks();\n  if (t === 'goals') return renderGoals();\n  if (t === 'events') return renderEvents();\n  if (t === 'notifications') return renderNotifications();\n  if (t === 'search') return renderSearch();\n  if (t === 'settings') return renderSettings();\n  return el('div');\n}\n\nfunction renderCurrent() {\n  const screens = $('screens');\n  const t = state.tab;\n  const idx = TAB_ORDER.indexOf(t === 'search' ? 'dairy' : t);\n  const safeIdx = idx < 0 ? lastTabIndex : idx;\n  // направление сдвига: вперёд по вкладкам — вправо, назад — влево\n  const dir = (safeIdx === lastTabIndex) ? 0 : (safeIdx > lastTabIndex ? 1 : -1);\n  lastTabIndex = safeIdx;\n\n  settleScreens(screens); // завершить прерванную анимацию, если была\n\n  const node = document.createElement('div');\n  node.className = 'screen';\n  node.appendChild(buildScreen(t));\n\n  const old = screens.firstElementChild;\n  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  if (!old || reduce || !dir) {\n    screens.innerHTML = '';\n    screens.appendChild(node);\n  } else {\n    const tok = ++transitionToken;\n    // обе вкладки на время перехода лежат слоями\n    screens.classList.add('transitioning');\n    node.classList.add(dir > 0 ? 'enter-from-right' : 'enter-from-left');\n    old.classList.add(dir > 0 ? 'leave-to-left' : 'leave-to-right');\n    screens.appendChild(node);\n    void node.offsetWidth; // принудительный reflow, чтобы сработал transition\n    node.classList.add('in');\n    old.classList.add('out');\n\n    let finished = false;\n    const finish = () => {\n      if (finished) return;\n      finished = true;\n      if (old.parentNode) old.remove();\n      node.classList.remove('enter-from-right', 'enter-from-left', 'in');\n      if (tok === transitionToken) screens.classList.remove('transitioning');\n    };\n    old.addEventListener('transitionend', finish, { once: true });\n    setTimeout(finish, 420);\n  }\n\n  document.querySelectorAll('.nav-item').forEach(b =>\n    b.classList.toggle('active', b.dataset.tab === (t === 'search' ? 'dairy' : t)));\n}\n\nfunction showApp() {\n  $('loginScreen').classList.add('hidden');\n  $('appScreen').classList.remove('hidden');\n  updateBell();\n  renderCurrent();\n  if (!showApp._notifChecked) {\n    showApp._notifChecked = true;\n    checkNotifications();\n  }\n}\n\n// ---------------- Ивенты ----------------\n$('loginBtn').onclick = doLogin;\n$('loginField').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('passwordField').focus(); });\n$('passwordField').addEventListener('keydown', (e) => { if (e.key === 'Enter') doLogin(); });\n$('searchIcon').onclick = () => { state.tab = 'search'; renderCurrent(); };\n$('bellIcon').onclick = () => { state.tab = 'notifications'; renderCurrent(); };\n$('bellIcon').onclick = () => { state.tab = 'notifications'; renderCurrent(); };\ndocument.querySelectorAll('.nav-item').forEach(b => {\n  b.onclick = () => { state.tab = b.dataset.tab; renderCurrent(); };\n});\n\n// ---------------- Анимация запуска (SplashActivity) ----------------\n// Терминал печатает строки, затем проявляется логотип и «Добро пожаловать».\nconst SPLASH_LINES = [\n  '> инициализация системы',\n  '> загружаю задания... ок',\n  '> загружаю оценки... ок',\n  '> загружаю дневник... ок',\n  '> готово'\n];\nconst SPLASH_TYPING_END = 1150;\nconst SPLASH_HOLD_END = 2350;\nconst SPLASH_TOTAL = SPLASH_LINES.reduce((a, l) => a + l.length, 0);\n\nfunction runSplash(onDone) {\n  const splash = $('splash');\n  const term = $('splashTerminal');\n  const start = performance.now();\n\n  function frame(now) {\n    const t = now - start;\n    const shown = Math.min(t / SPLASH_TYPING_END, 1) * SPLASH_TOTAL;\n    let consumed = 0;\n    let html = '';\n    let cursored = false;\n\n    for (const line of SPLASH_LINES) {\n      const remaining = shown - consumed;\n      if (remaining > 0.5) {\n        const chars = Math.min(Math.floor(remaining), line.length);\n        const visible = line.slice(0, chars);\n        if (chars < line.length) {\n          html += '<div class=\"tline typing\">' + visible + '<span class=\"cursor\"></span></div>';\n          cursored = true;\n        } else {\n          html += '<div class=\"tline\">' + visible + '</div>';\n        }\n      }\n      consumed += line.length;\n    }\n    if (!cursored && shown >= SPLASH_TOTAL && t < SPLASH_TYPING_END + 250) {\n      html += '<div class=\"tline typing\"><span class=\"cursor\"></span></div>';\n    }\n    term.innerHTML = html;\n\n    if (t < SPLASH_HOLD_END) {\n      requestAnimationFrame(frame);\n    } else {\n      splash.classList.add('done');\n      setTimeout(() => {\n        splash.style.display = 'none';\n        onDone();\n      }, 320);\n    }\n  }\n  requestAnimationFrame(frame);\n}\n\n// ---------------- Автологин при старте ----------------\nasync function startApp() {\n  const l = Prefs.login(), p = Prefs.password();\n  if (l && p) {\n    await Diary.restoreSession(l, p); // дождаться SHA-1, иначе запросы уйдут без cookie\n    showApp();\n  }\n}\n\nrunSplash(startApp);\n</script>\n</body>\n</html>"